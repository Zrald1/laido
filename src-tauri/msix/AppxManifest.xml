<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <!-- Partner Center: replace Name + Publisher with the assigned package identity
       (Partner Center → your app → Product management → Product identity).
       Publisher must equal the signing cert's CN. Version must be 4-part. -->
  <Identity
    Name="ZraldWebDevelopmentServices.Laido"
    Publisher="CN=Zrald Web Development Services"
    Version="0.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Laido</DisplayName>
    <PublisherDisplayName>Zrald Web Development Services</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Laido" Executable="laido.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Laido"
        Description="Laido — local-first AI notepad"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        BackgroundColor="transparent">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- desktop-bridge (Centennial) app — full trust, uses system WebView2 -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
