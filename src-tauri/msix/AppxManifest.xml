<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <!-- Partner Center identity — app: Laido, store id 9NT11XSG8H4B
       Publisher CN must equal the signing cert's subject. Version is
       substituted by make-msix.ps1 (4-part, must increase per submission). -->
  <Identity
    Name="ZRALDWEBDEVELOPMENTSERVIC.Laido"
    Publisher="CN=5681D04A-8CD3-43BB-AE2B-CE4042C680B1"
    Version="0.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Laido</DisplayName>
    <PublisherDisplayName>ZRALD WEB DEVELOPMENT SERVICES</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <!-- UI languages shipped in src/i18n.ts LANGS -->
    <Resource Language="en-us" />
    <Resource Language="es" />
    <Resource Language="fr" />
    <Resource Language="de" />
    <Resource Language="pt" />
    <Resource Language="it" />
    <Resource Language="nl" />
    <Resource Language="ru" />
    <Resource Language="tr" />
    <Resource Language="ar" />
    <Resource Language="zh" />
    <Resource Language="ja" />
    <Resource Language="ko" />
    <Resource Language="fil" />
  </Resources>

  <Applications>
    <Application Id="Laido" Executable="laido.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Laido"
        Description="Laido — local-first AI notepad"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        BackgroundColor="transparent">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- desktop-bridge (Centennial) app — full trust, uses system WebView2 -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
