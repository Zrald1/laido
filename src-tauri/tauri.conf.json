{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Laido",
  "version": "0.0.5",
  "identifier": "app.laido.desktop",
  "build": {
    "beforeDevCommand": "npm run ui",
    "beforeBuildCommand": "npm run ui",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}