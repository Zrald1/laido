{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Laido",
  "version": "0.0.1",
  "identifier": "app.laido.desktop",
  "build": {
    "beforeDevCommand": "npm run ui",
    "beforeBuildCommand": "npm run ui",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Laido",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 460,
        "decorations": false,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
